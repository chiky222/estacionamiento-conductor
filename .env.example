# mock = API simulada en el navegador (no hace falta back). api = back real.
NEXT_PUBLIC_API_MODE=mock
# develop = usa NEXT_PUBLIC_API_URL_DEV. Cualquier otro valor usa NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_ENTORNO=develop
NEXT_PUBLIC_API_URL_DEV=http://localhost:8080
NEXT_PUBLIC_API_URL=
# Google Maps JavaScript API (restringida por dominio). Sin key se muestra un mapa de muestra.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID de Google Cloud (hace falta para los marcadores personalizados). DEMO_MAP_ID sirve para desarrollo.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Public key de Mercado Pago (para tokenizar la tarjeta en el navegador). La access token va solo en el back.
NEXT_PUBLIC_MP_PUBLIC_KEY=
